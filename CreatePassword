import string 
import random
import time
def create_password():
    

    password = []

    Letters = string.ascii_letters
    Digits = string.digits
    Shapes = string.punctuation

    def random_letters(number):
        for _ in range(number):
                letter = random.choice(Letters) 
                password.append(letter)

    def random_shapes(number):
        for _ in range(number):
            shape = random.choice(Shapes)
            password.append(shape)

    def random_digits(number):
        for _ in range(number):
            digit = random.choice(Digits)
            password.append(digit)
                
    #Number Of Digits
    NOD = int(input('Number of Digits : '))

    #Number Of Letters
    NOL = int(input('Number of Letters : '))

    #Number Of Shapes
    NOS = int(input('Number of Shapes : '))

    random_digits(NOD)
    random_letters(NOL)
    random_shapes(NOS)

    random.shuffle(password) 
    MasterPassword = ''.join(password) 
    
    
    print('Creating Password ....')
    time.sleep(2)
    
    return MasterPassword