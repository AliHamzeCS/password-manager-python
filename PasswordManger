from colorama import Fore, Style, init
init()
import time
import os
from CreatePassowrd import create_password

accounts = {
	# 'email' = 'password'
}

def clear_screen():
    os.system('cls' if os.name == 'nt' else 'clear') 

def sleep():
	time.sleep(2) 

PY = 'password manager'
print('='*40)
print(PY.center(40,' ').upper())
print('='*40 , end = '\n\n')

while True:
    
    print(f"{Fore.RED}1{Style.RESET_ALL}. Added Password")      
    print(f"{Fore.RED}2{Style.RESET_ALL}. Show Accounts")
    print(f"{Fore.RED}3{Style.RESET_ALL}. Search Account")
    print(f"{Fore.RED}4{Style.RESET_ALL}. Update Password")
    print(f"{Fore.RED}5{Style.RESET_ALL}. Delete Account")
    print(f"{Fore.RED}6{Style.RESET_ALL}. Exit" , end = '\n\n')
    
    choice = int(input('choose a number : '))
    
    if choice == 1:
        clear_screen()
        sleep()
        print(f'{Fore.BLUE}-Added Password{Style.RESET_ALL}')
        
        email = input('Enter an email : ')
        
        choice_password = input('Do you have a password ? If we don\'t create a new password (Y,N) ').lower()
        
        if choice_password == 'y':
            password = input('Enter Password : ')
        else :
            password = create_password() 
            print(f'Password {password}') 
    	
        accounts[email] = password
        

    elif choice == 2:
        clear_screen()
        sleep()
        print(f'{Fore.BLUE}-Show Accounts{Style.RESET_ALL}')
        
        print(f'{Fore.YELLOW}E{Style.RESET_ALL}mail  -  {Fore.GREEN}P{Style.RESET_ALL}assword')
        
        for email in accounts:
            print(f'{Fore.YELLOW}{email}{Style.RESET_ALL}  -  {Fore.GREEN}{accounts[email]}{Style.RESET_ALL}')
            
         	
    elif choice == 3:
        clear_screen()
        sleep()
        print(f'{Fore.BLUE}-Search Account{Style.RESET_ALL}')
        
        input_email = input('Write Email : ')
        if input_email in accounts:
            print(f'{Fore.YELLOW}Email{Style.RESET_ALL} : {input_email}')
            print(f'{Fore.GREEN}Password{Style.RESET_ALL} : {accounts[input_email]}')
        else:
            print('Account does not exist')
    	
    elif choice == 4:
        clear_screen()
        sleep()
        print(f'{Fore.BLUE}-Update Password{Style.RESET_ALL}')
        
        updated_email = input('Enter Email : ')
        if updated_email in accounts:
            updated_password = input('Enter a new password : ')
            accounts[updated_email] = updated_password

            print(f'{Fore.YELLOW}Email{Style.RESET_ALL} : {updated_email}')
            print(f'{Fore.GREEN}Password{Style.RESET_ALL} : {accounts[updated_email]}')
        else:
            print('Account does not exist')
                
    elif choice == 5:
        clear_screen()
        sleep()
        print(f'{Fore.BLUE}-Delete Account{Style.RESET_ALL}')
        
        deleted_account = input('Enter an email : ')
        if deleted_account in accounts:
            deleted_password = input('Enter password : ')

            if deleted_password == accounts[deleted_account]:
                del accounts[deleted_account]
                print('Account deleted successfully')
            else:
                print('Incorrect password')
        else:
            print('Account does not exist')
    	
    elif choice == 6:
        sleep()
        print('Exit ....')
        sleep()
        clear_screen()
        break
    
    